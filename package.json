{
  "name": "talleres-club-abierto",
  "version": "1.0.0",
  "private": true,
  "description": "PWA y aplicaciones móviles de Talleres Club Abierto",
  "scripts": {
    "postinstall": "node scripts/build-cloudflare.mjs",
    "build:web": "node scripts/build-cloudflare.mjs",
    "mobile:prepare": "node scripts/build-mobile.mjs",
    "cap:sync": "npm run mobile:prepare && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
